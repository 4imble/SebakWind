    {
      "name": "Body Flicker (Shunshin)",
      "category": "chakra",
      "cost": "1 Chakra, Bonus Action",
      "status": "active",
      "description": "Teleport/dash up to 30 ft. to an unoccupied space you can see without provoking opportunity attacks."
